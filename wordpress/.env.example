# =====================================================================
#  GenScan2.0 — WordPress .env
#
#  1) Kopieer dit bestand naar  .env   (zonder extensie):
#         copy .env.example .env
#  2) Pas de waarden hieronder aan (vooral de wachtwoorden).
#
#  LET OP: .env staat in .gitignore en wordt NIET naar GitHub gestuurd.
# =====================================================================

# ---- Database (lokaal, draait binnen Docker) ----
DB_NAME=genstack
DB_USER=genstack
DB_PASSWORD=GenScan_WP_2026_change_me
DB_ROOT_PASSWORD=GenScan_WP_root_2026_change_me

# ---- Tabellenprefix (optioneel; helpt bij beveiliging) ----
WP_TABLE_PREFIX=genstack_

# ---- Web / adressen ----
# De lokale URL zoals de site bereikbaar is.
# Gebruik voor een domein op een FQDN (bv. http://genstack.local)
# dit adres en werk daarna het domein op naar die naam.
WP_SITE_URL=http://localhost:8080
# Poort voor de WordPress-site
WP_HTTP_PORT=8080
# Poort voor phpMyAdmin (optioneel)
PMA_PORT=8081

# ---- Eerste (admin)gebruiker ----
# Dit account wordt gebruikt bij het installeren van WordPress.
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@fvbrugge.be
WP_ADMIN_PASSWORD=GenScan_Admin_2026_change_me
